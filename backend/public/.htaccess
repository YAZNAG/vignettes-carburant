# Production : le frontend React (index.html, assets/) est copié dans ce
# dossier et servi par Apache ; Laravel ne traite que l'API.
# En développement (php artisan serve), ce fichier est ignoré.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel : API, cookies Sanctum, contrôle de santé
    RewriteRule ^(api|sanctum|up)(/|$) index.php [L]

    # Fichiers et dossiers existants servis tels quels
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste : application React (SPA)
    RewriteRule ^ index.html [L]
</IfModule>
