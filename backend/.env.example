# =============================================================================
# Gestion des vignettes carburant — configuration d'environnement
# Copier ce fichier vers .env puis exécuter : php artisan key:generate
# AUCUN secret ne doit être commité dans le dépôt Git.
# =============================================================================

APP_NAME="Gestion Vignettes Carburant"
# local | production
APP_ENV=local
# Générée par php artisan key:generate — ne jamais la partager
APP_KEY=
# false OBLIGATOIRE en production (masque les erreurs techniques)
APP_DEBUG=true
# URL du backend (avec port éventuel)
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

# URL du frontend React (liens des e-mails, CORS, Sanctum)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------------------------------------
# Hachage des mots de passe : argon2id (recommandé) ou bcrypt (repli)
# -----------------------------------------------------------------------------
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de données PostgreSQL 15+
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vignettes_carburant
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions (authentification par cookie HttpOnly SameSite=Lax)
# SESSION_LIFETIME : valeur de repli ; la durée réelle est le paramètre
# « durée d'inactivité » modifiable par l'administrateur dans l'application.
# En production HTTPS : SESSION_SECURE_COOKIE=true
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
# domaine SANS port (ex. app.organisme.ma) ; localhost en développement
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Domaines du frontend autorisés à s'authentifier par cookie (hôte:port)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Mot de passe du compte admin seedé (changement forcé à la 1re connexion)
# SEED_ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# E-mails (réinitialisation de mot de passe, notifications de sécurité)
# En développement : MAIL_MAILER=log (les mails partent dans storage/logs)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="vignettes@organisme.ma"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
